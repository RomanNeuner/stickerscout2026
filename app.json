{
  "expo": {
    "name": "AI Sticker Swap 2026",
    "slug": "stickerswap2026",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "at.ncn.stickerswap2026",
      "infoPlist": {
        "NSCameraUsageDescription": "Der Sticker-Scanner benötigt Zugriff auf die Kamera.",
        "NSLocationWhenInUseUsageDescription": "Für lokale Tauschpartner-Suche wird dein Standort benötigt.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "at.ncn.stickerswap2026",
      "adaptiveIcon": {
        "backgroundColor": "#0A1A0F",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-camera",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Für lokale Tauschpartner-Suche wird dein Standort benötigt."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f5b15be1-3563-403e-b727-295af9f553c2"
      }
    },
    "owner": "rommi"
  }
}
