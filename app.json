{
  "expo": {
    "name": "StickerScout 2026",
    "slug": "stickerswap2026",
    "version": "1.1.26",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "at.ncn.stickerscout2026",
      "buildNumber": "1",
      "minimumOsVersion": "16.0",
      "infoPlist": {
        "NSCameraUsageDescription": "Der Sticker-Scanner benötigt Zugriff auf die Kamera.",
        "NSLocationWhenInUseUsageDescription": "Für lokale Tauschpartner-Suche wird dein Standort benötigt.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "at.ncn.stickerscout2026",
      "edgeToEdgeEnabled": true,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-background.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "expo-localization",
      "expo-camera",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Für lokale Tauschpartner-Suche wird dein Standort benötigt."
        }
      ],
      "expo-mail-composer",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F5C033",
          "defaultChannel": "general",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "StickerScout 2026"
        }
      ],
      "expo-sharing",
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "f5b15be1-3563-403e-b727-295af9f553c2"
      }
    },
    "owner": "rommi"
  }
}
